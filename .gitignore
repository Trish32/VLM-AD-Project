# --- Model weights / checkpoints (too large for GitHub) ---
*.pt
*.pth
*.ckpt

# --- Claude artifacts ---
.claude/
Claude.md
CLAUDE.md

# --- Project outputs (excluded per request) ---
sparse4d_vldrive/sparse4d_outputs/

# --- diffusiondrive_planner (moved from VLAProjects; rules carried over) ---
# Pinned upstream clones (nested git repos; re-cloned, never vendored).
# Commits are pinned in the project README; see its patches/ for our edits.
diffusiondrive_planner/upstream/
diffusiondrive_planner/upstream-nusc/
# Generated working data (regenerable; demo media lives in assets/)
diffusiondrive_planner/data/
diffusiondrive_planner/checkpoints/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- OS / editor cruft ---
.DS_Store

# Disabled nested git repos (renamed aside, not for pushing)
*.git_disabled/

# --- traffic-light annotation set: 16 MB of crops, fully regenerable from
#     tools/make_light_annotation.py. The LABELS are the valuable artifact and
#     live in tools/light_labels.jsonl, which IS tracked.
bevformer_vldrive/bev_outputs/light_annotation/

# --- closed-loop rollout output: regenerable from closed_loop.py, and the
#     numbers that matter are quoted in e2e_pipeline/README.md
e2e_pipeline/closed_loop_results.json

# --- scratch renders written by the ablation/scoring tools ---
bevformer_vldrive/eval_results/_*.png
bevformer_vldrive/bev_outputs/latest_bev_grid.jpg

# --- RETRACTED: produced before the ablation determinism fix (temperature 0.1),
#     where an arm compared against itself agreed 0/6 across two runs. Kept
#     locally for reference; not published, because they read as findings.
bevformer_vldrive/eval_results/gt_detection_ablation.json
bevformer_vldrive/eval_results/gt_detection_ablation_nolight.json
bevformer_vldrive/eval_results/velocity_ablation.json
# Smoke-test output built from RANDOM labels, not real annotation.
bevformer_vldrive/eval_results/light_scores.json

# --- nuScenes detection submissions: 23 MB, fully regenerable by re-running
#     tools/eval.py. Every number the README quotes lives in summary.json,
#     which IS tracked.
bevformer_vldrive/eval_results/nuscenes_results.json
bevformer_vldrive/eval_results/results_mini_*.json
bevformer_vldrive/eval_results/mini_val/
bevformer_vldrive/eval_results/mini_train/

# --- prompts (kept local, excluded from GitHub) ---
bevformer_vldrive/prompts.txt

# --- scene GIFs: only the README demo is tracked. scene-0757 is the demo
#     because it is the case the four-channel pipeline exists for: a red light
#     with a completely clear road, which a BEV-only planner cannot get right.
bevformer_vldrive/bev_outputs/scene_gifs/*
!bevformer_vldrive/bev_outputs/scene_gifs/scene08_scene-1094_bev.gif

# --- per-frame scratch renders: regenerable from infer.py / vis_infer.py ---
bevformer_vldrive/bev_outputs/vis_*.png
bevformer_vldrive/bev_outputs/bev_*.png
bevformer_vldrive/bev_outputs/cameras/
bevformer_vldrive/bev_outputs/_vlm_query.png

# --- project memory (kept local, excluded from GitHub) ---
bevformer_vldrive/memory/

# --- editor config (local only) ---
.vscode/

# --- simulator: keep only GIFs, not the per-frame render images ---
simulator/sim_outputs/frame_*.png
simulator/sim_outputs/world_*.png
simulator/sim_outputs/combo_*.png
simulator/sim_outputs/cam/

# --- sparse4d_vldrive: keep only the tracking GIF, not per-frame renders ---
sparse4d_vldrive/sparse4d_track_outputs/track_*.png
sparse4d_vldrive/sparse4d_track_outputs/bev_*.png
sparse4d_vldrive/sparse4d_track_outputs/combo_*.png

